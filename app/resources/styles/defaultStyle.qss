/* Адаптивное меню: цвета подтягиваются из текущей темы Windows/Linux/macOS */
QMenu {
    /* Используем Window вместо window, чтобы Qt гарантированно понял роль */
    background-color: palette(Window);       
    color: palette(WindowText);              /* ИСПРАВЛЕНО: CamelCase без дефиса */
    border: 1px solid palette(Mid);          
    padding: 4px 0px;
}

/* Элемент меню при наведении */
QMenu::item:selected {
    background-color: palette(Highlight);     
    color: palette(HighlightedText);         /* ИСПРАВЛЕНО: CamelCase без дефиса */
}

QMenu::separator {
    height: 1px;
    background-color: palette(Mid);
    margin: 4px 0px;
}
QToolButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    margin: 0px;
}